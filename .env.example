# agentic-researcher environment — copy to .env (git-ignored) and fill in.

# Bearer token for the hosted openbrain MCP server (over your SSH tunnel).
# Must match the server's MCP_ACCESS_KEY. Read by researcher/config.py at runtime.
OPENBRAIN_MCP_TOKEN=

# The MCP endpoint itself is NOT here — it's in config.yaml as `openbrain_mcp_url`
# (e.g. http://localhost:8000/mcp once your tunnel is up). Set it there.

# Local path to a CA cert for the private MCP endpoint (self-signed TLS). Unset by
# default; when set, it overrides `openbrain_ca_cert` in config.yaml so no personal
# filesystem path lives in tracked config.
OPENBRAIN_CA_CERT=
